{
  "name": "agentic-monorepo-starter",
  "description": "Monorepo template for agent-assisted development",
  "private": true,
  "engines": {
    "node": "^24.21.0 || >=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "gen:package": "gen run package",
    "secrets:scan": "sh tooling/github/scripts/secrets-scan.sh",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@repo/prettier": "workspace:*",
    "@turbo/gen": "2.10.13",
    "@types/node": "catalog:",
    "knip": "6.35.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "2.10.13",
    "typescript": "catalog:"
  },
  "prettier": "@repo/prettier"
}
