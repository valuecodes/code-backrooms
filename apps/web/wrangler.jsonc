{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-backrooms-web",
  // The pinned wrangler's workerd version (1.YYYYMMDD.x) caps this date; newer dates
  // fail in `wrangler dev`. Bump it together with wrangler.
  "compatibility_date": "2026-09-11",
  "observability": { "enabled": true },
  // The Worker serves only /api/* (the GitHub zip route); everything else is Vite's
  // build output, including public/_headers, served without running it. No
  // not_found_handling: the app is a single page without routes, so unknown paths 404.
  "main": "src/api/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  // Per visitor IP, on top of the Turnstile check. namespace_id is any number unique
  // to this account's rate limiters; it is not a secret.
  "ratelimits": [
    {
      "name": "GITHUB_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // TURNSTILE_SECRET is a secret set in the Cloudflare dashboard (or with
  // `wrangler secret put`), and in an uncommitted .dev.vars for `wrangler dev`.
}
