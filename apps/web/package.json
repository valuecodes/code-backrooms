{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "dev:worker": "mkdir -p dist && wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "clean": "rm -rf .turbo node_modules .cache .wrangler dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/fiber": "catalog:",
    "@repo/code-graph": "workspace:*",
    "@repo/parser": "workspace:*",
    "@repo/renderer": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/world-generator": "workspace:*",
    "fflate": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
